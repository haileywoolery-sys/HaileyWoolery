# Jupyter Notebook cache
.ipynb_checkpoints

# pipenv
#   According to pypa/pipenv#118, it is NOT recommended to ignore Pipfile.lock.
#   If your project is a Python package, ignore it. If it is an application, track it.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, ignore or track based on your project type.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, ignore or track based on your project type.
#pdm.lock
.pdm-plugins/

